{
  "name": "ddex",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build:wasm": "node ./scripts/build-wasm.mjs",
    "dev": "node ./scripts/run-dev.mjs",
    "dev:services": "node ./scripts/run-dev.mjs --skip-wasm",
    "dev:proxy": "cd proxy && docker compose up --build",
    "dev:frontend": "cd frontend && vite",
    "dev:proxy:down": "cd proxy && docker compose down",
    "start:frontend": "pnpm run build:wasm && pnpm --filter ./frontend dev",
    "setup:rust": "bash ./scripts/setup-rust.sh",
    "build": "pnpm run build:wasm && pnpm --filter ./frontend build",
    "lint": "pnpm --filter ./frontend lint",
    "typecheck": "pnpm --filter ./frontend typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx}": [
      "eslint --max-warnings 0"
    ]
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": ">=7.0.3",
      "brace-expansion@<2": ">=1.1.13",
      "brace-expansion@>=2": ">=2.0.3"
    }
  }
}
