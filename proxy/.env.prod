# Production environment for Envoy proxy on the server.
# Same MobileCoin endpoints as .env, but proxy binds to localhost only
# (nginx terminates TLS and forwards gRPC-Web paths here).

# Testnet
MC_TEST_FOG_HOST=fog.test.mobilecoin.com
MC_TEST_FOG_PORT=443
MC_TEST_CONSENSUS_HOST=node1.test.mobilecoin.com
MC_TEST_CONSENSUS_PORT=443

# Mainnet
MC_PROD_FOG_HOST=fog.prod.mobilecoinww.com
MC_PROD_FOG_PORT=443
MC_PROD_CONSENSUS_HOST=node1.prod.mobilecoinww.com
MC_PROD_CONSENSUS_PORT=443

# Envoy
ENVOY_PORT=8080
ENVOY_LOG_LEVEL=info
