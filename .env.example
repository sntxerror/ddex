# === MobileCoin Networks ===
# Proxy routes both networks simultaneously:
#   /test/fog/*        → testnet fog
#   /test/consensus/*  → testnet consensus
#   /prod/fog/*        → mainnet fog
#   /prod/consensus/*  → mainnet consensus

# Testnet
MC_TEST_FOG_HOST=fog.test.mobilecoin.com
MC_TEST_FOG_PORT=443
MC_TEST_CONSENSUS_HOST=node1.test.mobilecoin.com
MC_TEST_CONSENSUS_PORT=443

# Mainnet
MC_PROD_FOG_HOST=fog.prod.mobilecoinww.com
MC_PROD_FOG_PORT=443
MC_PROD_CONSENSUS_HOST=node1.prod.mobilecoinww.com
MC_PROD_CONSENSUS_PORT=443

# === Envoy gRPC-Web Proxy ===
ENVOY_PORT=8080
ENVOY_LOG_LEVEL=info
ENVOY_IMAGE=envoyproxy/envoy:v1.31-latest

# === Frontend (Vite) ===
# Default network for the wallet UI (testnet | mainnet)
VITE_MC_NETWORK=testnet
VITE_PROXY_URL=http://localhost:8080

# Fog report URLs per network
VITE_TESTNET_FOG_REPORT_URL=fog://fog.test.mobilecoin.com
VITE_MAINNET_FOG_REPORT_URL=fog://fog-rpt-prd.namda.net

# Fog authority SPKI — base64-encoded DER RSA SubjectPublicKeyInfo
# Testnet: empty (testnet fog does not require authority verification)
VITE_TESTNET_FOG_AUTHORITY_SPKI=
# Mainnet: Signal's fog authority public key (from signalapp/Signal-Android MobileCoinMainNetConfig.java)
VITE_MAINNET_FOG_AUTHORITY_
